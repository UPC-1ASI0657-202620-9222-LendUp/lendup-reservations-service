<configuration>
  <springProfile name="prod">
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender"><encoder class="net.logstash.logback.encoder.LogstashEncoder"/></appender>
    <root level="INFO"><appender-ref ref="STDOUT"/></root>
  </springProfile>
  <springProfile name="!prod">
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>%d{ISO8601} %-5level [%X{correlation_id:-}] %logger{36} - %msg%n</pattern></encoder></appender>
    <root level="INFO"><appender-ref ref="STDOUT"/></root>
  </springProfile>
</configuration>
